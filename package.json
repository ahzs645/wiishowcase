{
  "name": "wiishowcase",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build:layout && node scripts/sync-wii-css-assets.mjs && concurrently -n vite,sass -c blue,magenta \"vite\" \"sass --watch Wii.css/src/index.scss Wii.css/dist/wii.css\"",
    "dev:vite": "npm run build:layout && vite",
    "build:css": "node scripts/sync-wii-css-assets.mjs && sass Wii.css/src/index.scss Wii.css/dist/wii.css",
    "build:news-channel": "cd news-channel && npx ng build",
    "prebuild": "npm run build:layout && node scripts/generate-build-version.mjs",
    "build": "npm run build:css && vite build",
    "build:all": "npm run build:news-channel && npm run build",
    "export:channel-bundle": "node scripts/export-channel-bundle.mjs",
    "fetch:wii-css": "node scripts/fetch-wii-css.mjs",
    "preview": "vite preview",
    "test:smoke": "node scripts/smoke-test.mjs",
    "test:channel-audio": "node scripts/test-channel-audio.mjs",
    "test:channel-loading": "node scripts/test-channel-loading.mjs",
    "profile:thumbnails": "node scripts/profile-thumbnail-backends.mjs",
    "test:native-apps": "node scripts/test-native-applications.mjs",
    "test:channel-presentation": "node scripts/test-channel-presentation.mjs",
    "audit:shop-keyboard": "node scripts/audit-shop-keyboard.mjs",
    "test:shop-keyboard": "node scripts/test-shop-keyboard.mjs",
    "compare:keyboard-keys": "node scripts/compare-keyboard-keys.mjs",
    "capture:interface-audit": "node scripts/capture-interface-audit.mjs",
    "build:interface-audit": "node scripts/build-interface-audit.mjs",
    "check:interface-native-sizes": "node scripts/check-interface-native-sizes.mjs",
    "test:system-interface": "node scripts/test-system-interface.mjs",
    "build:interface-improvements": "node scripts/build-interface-improvements.mjs",
    "postbuild": "node scripts/package-interface-comparisons.mjs",
    "test:system-controllers": "node scripts/test-system-controllers.mjs",
    "test:interface-sizing": "node scripts/test-system-interface.mjs --sizing",
    "build:interface-sizing": "node scripts/build-interface-sizing.mjs && python scripts/render-interface-sizing-overviews.py",
    "test:menu-fidelity": "node scripts/test-menu-fidelity.mjs",
    "build:menu-fidelity": "node scripts/build-menu-fidelity.mjs && python scripts/render-menu-fidelity.py",
    "test:menu-typography": "node scripts/test-menu-typography.mjs",
    "build:menu-typography": "python scripts/render-menu-typography.py",
    "build:menu-versions": "python scripts/render-menu-version-comparisons.py",
    "test:menu-version-viewer": "node scripts/check-menu-version-viewer.mjs",
    "capture:menu-version-states": "node scripts/capture-menu-version-states.mjs",
    "build:layout": "node scripts/generate-layout-reference.mjs",
    "check:layout": "node scripts/generate-layout-reference.mjs --check",
    "capture:other-menus": "npm run capture:other-menus:core && node scripts/capture-other-menus.mjs",
    "build:other-menus": "node scripts/build-other-menus.mjs && python scripts/render-other-menus.py",
    "test:other-menu-viewer": "node scripts/check-other-menu-viewer.mjs",
    "capture:other-menus:core": "node scripts/capture-other-menu-core.mjs",
    "test:system-menu-fixes": "node scripts/test-system-menu-fixes.mjs && node scripts/test-system-pairing.mjs && node scripts/test-system-keyboard-focus.mjs",
    "build:system-menu-fixes": "node scripts/build-system-menu-fixes.mjs && python scripts/render-system-menu-fixes.py",
    "test:system-menu-fixes-viewer": "node scripts/check-system-menu-fixes-viewer.mjs",
    "relay:serve": "node server/relay.mjs",
    "test:relay": "node scripts/test-signaling-relay.mjs && node scripts/test-pairing-lifecycle.mjs",
    "test:automatic-pairing": "node scripts/test-automatic-controller-pairing.mjs",
    "build:system-menu-refinement": "SYSTEM_COMPARISON_OUTPUT=docs/system-menu-refinement SYSTEM_COMPARISON_BASELINE=system-menu-fixes node scripts/build-system-menu-fixes.mjs && SYSTEM_COMPARISON_OUTPUT=docs/system-menu-refinement SYSTEM_COMPARISON_BASELINE=system-menu-fixes python scripts/render-system-menu-fixes.py",
    "capture:storage-refinement": "node scripts/capture-storage-refinement.mjs",
    "build:storage-refinement": "node scripts/build-storage-refinement.mjs && python scripts/render-storage-refinement.py",
    "test:storage-refinement-viewer": "node scripts/check-storage-refinement.mjs",
    "test:interface-assets": "node scripts/test-interface-assets.mjs",
    "build:interface-assets": "node scripts/build-interface-asset-catalog.mjs && SYSTEM_COMPARISON_OUTPUT=docs/interface-assets SYSTEM_COMPARISON_BASELINE=system-menu-refinement node scripts/build-system-menu-fixes.mjs && SYSTEM_COMPARISON_OUTPUT=docs/interface-assets SYSTEM_COMPARISON_BASELINE=system-menu-refinement python scripts/render-system-menu-fixes.py && node scripts/build-interface-visual-review.mjs",
    "test:interface-assets-viewer": "SYSTEM_COMPARISON_OUTPUT=docs/interface-assets EXPECTED_COMPARISON_STATES=66 COMPARISON_URL=http://localhost:4957/interface-assets/ node scripts/check-system-menu-fixes-viewer.mjs",
    "test:interface-asset-catalog": "node scripts/check-interface-asset-catalog.mjs",
    "test:system-menu-refinement-viewer": "SYSTEM_COMPARISON_OUTPUT=docs/system-menu-refinement COMPARISON_URL=http://localhost:4957/system-menu-refinement/ node scripts/check-system-menu-fixes-viewer.mjs",
    "test:interface-visual-defects": "node scripts/test-interface-visual-defects.mjs",
    "test:interface-visual-review": "node scripts/check-interface-visual-review.mjs"
  },
  "dependencies": {
    "@firstform/wii-channel-renderer": "file:wewad/packages/wii-channel-renderer",
    "gsap": "^3.14.2",
    "miicreator": "file:../miicreateor",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^9.2.1",
    "jsqr": "^1.4.0",
    "playwright": "^1.57.0",
    "sass": "^1.97.3",
    "vite": "^8.0.16"
  },
  "overrides": {
    "shell-quote": "^1.8.4",
    "immutable": "^5.1.6"
  }
}
